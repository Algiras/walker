{
  "name": "walker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:Algiras/walker",
  "type": "module",
  "description": "Command a hero in a tower-defense map by voice. Whisper speech recognition and the Tev1 decision model, all in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "gen:audio": "tsx scripts/gen-audio.ts",
    "gen:voice": "tsx scripts/gen-voice.ts",
    "bench:llm": "tsx scripts/bench-llm.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "kokoro-js": "^1.2.1",
    "onnxruntime-node": "^1.30.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "onnxruntime-web": "^1.30.0"
  }
}
